# Copy to .env and fill in. No secrets in code.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Generator and judge must be DIFFERENT model families (self-enhancement bias)
GENERATOR_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
JUDGE_MODEL=particle-ai/particle-1:free

# Copy to .env and fill in. No secrets in code.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# Judge model for eval (different family than LLM_MODEL, measures self-enhancement bias)
JUDGE_MODEL=particle-ai/particle-1:free
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
INDEX_DIR=./data/index
CORPUS_DIR=./data/corpus
LOG_LEVEL=INFO
